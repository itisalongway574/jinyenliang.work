---
const message = "This website is currently under construction";
const repeatCount = 12;
const leftRotate = (Math.random() * 20 - 25).toFixed(2);
const rightRotate = (Math.random() * 20 + 5).toFixed(2);
const leftTranslate = (Math.random() * 80 - 90).toFixed(2);
const rightTranslate = (Math.random() * 80 - 90).toFixed(2);
---

<div
    class="construction-overlay pointer-events-none fixed inset-0 z-40 bg-black/50 backdrop-blur-sm"
>
    <div class="absolute left-0 top-1/2 z-50 w-full text-black">
        <div
            class="construction-track scale-150"
            style={`--marquee-rotate: ${leftRotate}deg; --marquee-translate: ${leftTranslate}%;`}
        >
            <div
                class="construction-marquee bg-yellow-400 py-1 font-medium uppercase tracking-wide md:text-base"
            >
                <div class="construction-marquee-track flex whitespace-nowrap">
                    {
                        Array.from({ length: repeatCount }).map(() => (
                            <span class="px-1 text-[10px]">{message}</span>
                        ))
                    }
                </div>
            </div>
        </div>
        <div
            class="construction-track scale-150"
            style={`--marquee-rotate: ${rightRotate}deg; --marquee-translate: ${rightTranslate}%;`}
        >
            <div
                class="construction-marquee bg-yellow-400 py-1 font-medium uppercase tracking-wide md:text-base"
            >
                <div class="construction-marquee-track flex whitespace-nowrap">
                    {
                        Array.from({ length: repeatCount }).map(() => (
                            <span class="px-1 text-[10px]">{message}</span>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes construction-marquee-in {
        0% {
            transform: translateY(100%);
        }
        100% {
            transform: translateY(0%);
        }
    }

    @keyframes construction-marquee-out {
        0% {
            transform: translateY(0%);
        }
        100% {
            transform: translateY(100%);
        }
    }

    @keyframes construction-mask-in {
        0% {
            opacity: 0;
        }
        100% {
            opacity: 1;
        }
    }

    @keyframes construction-mask-out {
        0% {
            opacity: 1;
        }
        100% {
            opacity: 0;
        }
    }

    .construction-overlay {
        opacity: 1;
        will-change: opacity;
    }

    .construction-overlay.is-entering {
        animation: construction-mask-in 0.5s ease-out both;
    }

    .construction-overlay.is-leaving {
        animation: construction-mask-out 0.5s ease-in both;
    }

    .construction-track {
        transform: translateY(var(--marquee-translate, -50%))
            rotate(var(--marquee-rotate, 0deg));
        overflow: hidden;
    }

    .construction-marquee {
        overflow: hidden;
    }

    .construction-marquee.is-entering {
        animation: construction-marquee-in 0.8s ease-out both;
    }

    .construction-marquee.is-leaving {
        animation: construction-marquee-out 0.8s ease-in both;
    }

    .construction-marquee-track {
        width: max-content;
    }
</style>

<script type="module">
    const IDLE_DELAY = 10000;
    const EXIT_DELAY = 3000;
    const STAGGER_DELAY = 200;

    const initConstructionMarquee = () => {
        if (window.__constructionMarqueeInit) {
            return;
        }
        window.__constructionMarqueeInit = true;

        const marquees = Array.from(
            document.querySelectorAll(".construction-marquee"),
        );
        const overlay = document.querySelector(".construction-overlay");
        if (!marquees.length || !overlay) {
            console.warn("[construction-marquee] 找不到 marquee");
            return;
        }

        let idleTimer = null;
        let exitTimer = null;

        const clearTimers = () => {
            if (idleTimer) window.clearTimeout(idleTimer);
            if (exitTimer) window.clearTimeout(exitTimer);
            idleTimer = null;
            exitTimer = null;
        };

        const setEntering = () => {
            overlay.classList.remove("is-leaving");
            overlay.classList.add("is-entering");
            marquees.forEach((marquee, index) => {
                window.setTimeout(() => {
                    marquee.classList.remove("is-leaving");
                    marquee.classList.add("is-entering");
                }, index * STAGGER_DELAY);
            });
        };

        const setLeaving = () => {
            overlay.classList.remove("is-entering");
            overlay.classList.add("is-leaving");
            marquees.forEach((marquee, index) => {
                window.setTimeout(() => {
                    marquee.classList.remove("is-entering");
                    marquee.classList.add("is-leaving");
                }, index * STAGGER_DELAY);
            });
        };

        const scheduleExit = () => {
            if (exitTimer) window.clearTimeout(exitTimer);
            exitTimer = window.setTimeout(() => {
                setLeaving();
            }, EXIT_DELAY);
        };

        const scheduleIdle = () => {
            if (idleTimer) window.clearTimeout(idleTimer);
            idleTimer = window.setTimeout(() => {
                setEntering();
            }, IDLE_DELAY);
        };

        const onUserActive = () => {
            setLeaving();
            scheduleIdle();
        };

        const onVisibilityChange = () => {
            if (document.hidden) {
                scheduleIdle();
            }
        };

        const activityEvents = [
            "mousemove",
            "mousedown",
            "keydown",
            "touchstart",
            "wheel",
        ];
        activityEvents.forEach((eventName) => {
            window.addEventListener(eventName, onUserActive, { passive: true });
        });
        window.addEventListener("visibilitychange", onVisibilityChange);
        window.addEventListener("blur", scheduleIdle);

        clearTimers();
        marquees.forEach((marquee) => {
            marquee.classList.remove("is-entering", "is-leaving");
        });
        overlay.classList.remove("is-entering", "is-leaving");
        scheduleExit();
        scheduleIdle();
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initConstructionMarquee);
    } else {
        initConstructionMarquee();
    }
</script>
