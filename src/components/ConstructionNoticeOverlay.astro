---
const message = "This website is currently under construction";
const repeatCount = 12;
---

<div
    class="construction-notice pointer-events-none fixed inset-0 z-40 bg-black/50 backdrop-blur-sm"
>
    <div class="absolute left-0 top-1/2 z-50 w-full text-black">
        <div class="construction-notice-track scale-150">
            <div
                class="construction-notice-row bg-yellow-400 py-1 font-medium uppercase tracking-wide md:text-base"
            >
                <div class="construction-notice-content flex whitespace-nowrap">
                    {
                        Array.from({ length: repeatCount }).map(() => (
                            <span class="px-1 text-[10px]">{message}</span>
                        ))
                    }
                </div>
            </div>
        </div>
        <div class="construction-notice-track scale-150">
            <div
                class="construction-notice-row bg-yellow-400 py-1 font-medium uppercase tracking-wide md:text-base"
            >
                <div class="construction-notice-content flex whitespace-nowrap">
                    {
                        Array.from({ length: repeatCount }).map(() => (
                            <span class="px-1 text-[10px]">{message}</span>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @keyframes construction-notice-in {
        0% {
            transform: translateY(100%);
        }
        100% {
            transform: translateY(0%);
        }
    }

    @keyframes construction-notice-out {
        0% {
            transform: translateY(0%);
        }
        100% {
            transform: translateY(100%);
        }
    }

    @keyframes construction-notice-mask-in {
        0% {
            opacity: 0;
        }
        100% {
            opacity: 1;
        }
    }

    @keyframes construction-notice-mask-out {
        0% {
            opacity: 1;
        }
        100% {
            opacity: 0;
        }
    }

    .construction-notice {
        opacity: 1;
        will-change: opacity;
    }

    .construction-notice.is-entering {
        animation: construction-notice-mask-in 0.5s ease-out both;
    }

    .construction-notice.is-leaving {
        animation: construction-notice-mask-out 0.5s ease-in both;
    }

    .construction-notice-track {
        transform: translateY(var(--marquee-translate, -50%))
            rotate(var(--marquee-rotate, 0deg));
        overflow: hidden;
    }

    .construction-notice-row {
        overflow: hidden;
    }

    .construction-notice-row.is-entering {
        animation: construction-notice-in 0.8s ease-out both;
    }

    .construction-notice-row.is-leaving {
        animation: construction-notice-out 0.8s ease-in both;
    }

    .construction-notice-content {
        width: max-content;
    }
</style>

<script type="module">
    const IDLE_DELAY = 10000;
    const EXIT_DELAY = 2000;
    const STAGGER_DELAY = 200;

    const initConstructionNoticeOverlay = () => {
        if (window.__constructionNoticeInit) {
            return;
        }
        window.__constructionNoticeInit = true;

        const rows = Array.from(
            document.querySelectorAll(".construction-notice-row"),
        );
        const overlay = document.querySelector(".construction-notice");
        const tracks = Array.from(
            document.querySelectorAll(".construction-notice-track"),
        );
        if (!rows.length || !overlay) {
            console.warn("[construction-notice] 找不到 notice");
            return;
        }

        const rand = (min, max) => Math.random() * (max - min) + min;
        // 每次重新整理都重新產生隨機角度與位移
        if (tracks.length >= 2) {
            tracks[0].style.setProperty(
                "--marquee-rotate",
                `${rand(-25, -5).toFixed(2)}deg`,
            );
            tracks[0].style.setProperty(
                "--marquee-translate",
                `${rand(-90, -10).toFixed(2)}%`,
            );
            tracks[1].style.setProperty(
                "--marquee-rotate",
                `${rand(5, 25).toFixed(2)}deg`,
            );
            tracks[1].style.setProperty(
                "--marquee-translate",
                `${rand(-90, -10).toFixed(2)}%`,
            );
        }

        let idleTimer = null;
        let exitTimer = null;

        const broadcastOverlay = (active) => {
            window.__CONSTRUCTION_OVERLAY_ACTIVE__ = active;
            window.dispatchEvent(
                new CustomEvent("construction:overlay", { detail: { active } }),
            );
        };

        const clearTimers = () => {
            if (idleTimer) window.clearTimeout(idleTimer);
            if (exitTimer) window.clearTimeout(exitTimer);
            idleTimer = null;
            exitTimer = null;
        };

        const setEntering = () => {
            broadcastOverlay(true);
            overlay.classList.remove("is-leaving");
            overlay.classList.add("is-entering");
            rows.forEach((row, index) => {
                window.setTimeout(() => {
                    row.classList.remove("is-leaving");
                    row.classList.add("is-entering");
                }, index * STAGGER_DELAY);
            });
        };

        const setLeaving = () => {
            broadcastOverlay(false);
            overlay.classList.remove("is-entering");
            overlay.classList.add("is-leaving");
            rows.forEach((row, index) => {
                window.setTimeout(() => {
                    row.classList.remove("is-entering");
                    row.classList.add("is-leaving");
                }, index * STAGGER_DELAY);
            });
        };

        const scheduleExit = () => {
            if (exitTimer) window.clearTimeout(exitTimer);
            exitTimer = window.setTimeout(() => {
                setLeaving();
            }, EXIT_DELAY);
        };

        const scheduleIdle = () => {
            if (idleTimer) window.clearTimeout(idleTimer);
            idleTimer = window.setTimeout(() => {
                setEntering();
            }, IDLE_DELAY);
        };

        const onUserActive = () => {
            setLeaving();
            scheduleIdle();
        };

        const onVisibilityChange = () => {
            if (document.hidden) {
                scheduleIdle();
            }
        };

        const activityEvents = ["mousemove", "touchstart", "touchmove"];
        activityEvents.forEach((eventName) => {
            window.addEventListener(eventName, onUserActive, { passive: true });
        });
        window.addEventListener("visibilitychange", onVisibilityChange);
        window.addEventListener("blur", scheduleIdle);

        clearTimers();
        rows.forEach((row) => {
            row.classList.remove("is-entering", "is-leaving");
        });
        overlay.classList.remove("is-entering", "is-leaving");
        broadcastOverlay(true);
        scheduleExit();
        scheduleIdle();
    };

    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded",
            initConstructionNoticeOverlay,
        );
    } else {
        initConstructionNoticeOverlay();
    }
</script>
