---
const links = [
    { label: "instagram", href: "https://www.instagram.com/jinyenliang/" },
    { label: "threads", href: "https://www.threads.com/@jinyenliang" },
    { label: "e-mail", href: "mailto:wadejin1996@gmail.com" },
    { label: "discord", href: "https://discord.com/invite/5EDNXJ8tR7" },
];
---

<div
    class="fixed z-100 bottom-4 left-1/2 -translate-x-1/2 flex gap-1 text-[clamp(10px,0.875vw,14px)]"
>
    {
        links.map((link, index) => (
            <>
                <a
                    class="group relative inline-block h-[1.5em] overflow-hidden"
                    href={link.href}
                    target="_blank"
                    rel="noreferrer"
                >
                    <div class="flex flex-col transition-transform duration-300 ease-out group-hover:-translate-y-1/2">
                        <div class="flex gap-1 items-center">
                            <svg
                                width="12"
                                height="12"
                                viewBox="0 0 12 12"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M12 11L12 1C12 0.450001 11.55 5.04867e-07 11 4.80825e-07L1 4.37114e-08C0.450001 1.96701e-08 5.04866e-07 0.45 4.80825e-07 1L4.37112e-08 11C1.96699e-08 11.55 0.45 12 1 12L11 12C11.55 12 12 11.55 12 11Z"
                                    fill="#666666"
                                    fill-opacity="0.5"
                                />
                                <path
                                    d="M3.64902 7.65253L6.79402 4.50753L4.99902 4.50753C4.72402 4.50753 4.49902 4.28253 4.49902 4.00753C4.49902 3.73253 4.72402 3.50753 4.99902 3.50753L7.99902 3.50753C8.27402 3.50754 8.49902 3.73254 8.49902 4.00754L8.49902 7.00753C8.49902 7.28253 8.27402 7.50753 7.99902 7.50753C7.72402 7.50753 7.49902 7.28253 7.49902 7.00753L7.49902 5.21253L4.35402 8.35753C4.15902 8.55253 3.84402 8.55253 3.64402 8.35753C3.44902 8.16253 3.44902 7.84753 3.64402 7.65253L3.64902 7.65253Z"
                                    fill="white"
                                />
                            </svg>

                            <span class="block">{link.label}</span>
                        </div>
                        <div class="flex gap-1 items-center">
                            <svg
                                width="12"
                                height="12"
                                viewBox="0 0 12 12"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <path
                                    d="M12 11L12 1C12 0.450001 11.55 5.04867e-07 11 4.80825e-07L1 4.37114e-08C0.450001 1.96701e-08 5.04866e-07 0.45 4.80825e-07 1L4.37112e-08 11C1.96699e-08 11.55 0.45 12 1 12L11 12C11.55 12 12 11.55 12 11Z"
                                    fill="#666666"
                                    fill-opacity="0.5"
                                />
                                <path
                                    d="M3.64902 7.65253L6.79402 4.50753L4.99902 4.50753C4.72402 4.50753 4.49902 4.28253 4.49902 4.00753C4.49902 3.73253 4.72402 3.50753 4.99902 3.50753L7.99902 3.50753C8.27402 3.50754 8.49902 3.73254 8.49902 4.00754L8.49902 7.00753C8.49902 7.28253 8.27402 7.50753 7.99902 7.50753C7.72402 7.50753 7.49902 7.28253 7.49902 7.00753L7.49902 5.21253L4.35402 8.35753C4.15902 8.55253 3.84402 8.55253 3.64402 8.35753C3.44902 8.16253 3.44902 7.84753 3.64402 7.65253L3.64902 7.65253Z"
                                    fill="white"
                                />
                            </svg>

                            <span class="block">{link.label}</span>
                        </div>
                    </div>
                </a>
                {index < links.length - 1 && <span>/</span>}
            </>
        ))
    }
</div>
