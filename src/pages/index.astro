---
import BaseLayout from "../layouts/BaseLayout.astro";
import MarqueeColumn from "../components/MarqueeColumn.astro";
import ConstructionNoticeOverlay from "../components/ConstructionNoticeOverlay.astro";
import "../styles/global.css";
import {
    marqueeItemsLeft,
    marqueeItemsRight,
    marqueeItemsMobile,
} from "../data/marqueeProjects.js";
import marqueeControllerUrl from "../scripts/marqueeController.js?url";
---

<BaseLayout>
    <main class="relative min-h-screen overflow-hidden">
        {/* <ConstructionNoticeOverlay /> */}
        <aside
            class="fixed z-100 select-none left-1/2 -translate-x-1/2 top-0 flex h-screen flex-col justify-between items-center
            py-6"
        >
            <div class="text-[clamp(12px,1vw,16px)]">
                This website is under construction.
            </div>
            <div class="space-y-2 text-center">
                <h1
                    class="text-[clamp(2rem,3.5vw,3rem)] text-pretty leading-[1] tracking-[-0.02em]"
                >
                    jinyenliang.work
                </h1>
                <h2
                    class="text-[clamp(1.125rem,1.25vw,1.75rem)] leading-[1.2] tracking-[-0.01em]"
                >
                    web design &
                    <span class="text-nowrap">fronted-end develop</span>
                </h2>
            </div>
            <div class="flex gap-1 text-[clamp(12px,1vw,16px)]">
                <a target="_blank" href="https://www.instagram.com/jinyenliang/"
                    >instagram</a
                >
                <span>/</span>
                <a target="_blank" href="https://www.threads.com/@jinyenliang"
                    >threads</a
                >
                <span>/</span>
                <a target="_blank" href="mailto:wadejin1996@gmail.com">e-mail</a
                >
            </div>
        </aside>
        <!-- 作品marquee -->
        <section class="h-screen w-full">
            {/* 桌機左右欄：JS 控制進度 + wheel/drag/touch 共用邏輯 */}
            <div
                class="marquee-drag-area hidden h-full gap-6 md:flex"
                data-marquee-group="desktop"
            >
                {/* 左欄：自動往上，wheel 向下時會反向 */}
                <MarqueeColumn items={marqueeItemsLeft} dataMarquee="css" />
                {/* 右欄：自動往下，wheel 向下時會反向 */}
                <MarqueeColumn
                    items={marqueeItemsRight}
                    dataMarquee="css-reverse"
                    liClass="self-end"
                />
            </div>
            {/* 手機版：改為 JS 控制進度（可 touch/drag 改位移） */}
            <div class="h-full md:hidden">
                <MarqueeColumn
                    items={marqueeItemsMobile}
                    dataMarquee="mobile"
                    liClass="self-center"
                    wrapperClass="w-full"
                />
            </div>
        </section>
    </main>
    <script type="module" src={marqueeControllerUrl}></script>

    <style is:global>
        .is-dragging,
        .is-dragging * {
            cursor: grabbing;
        }

        .marquee-drag-area {
            cursor: grab;
        }

        .marquee-no-drag {
            -webkit-user-drag: none;
            user-select: none;
            -webkit-touch-callout: none;
        }

        @layer utilities {
            @keyframes marquee-vertical {
                0% {
                    transform: translateY(0);
                }

                100% {
                    transform: translateY(-50%);
                }
            }

            /* 桌機版 JS：透過 CSS 變數控制位移 */
            .marquee-wheel {
                transform: translateY(var(--marquee-offset, 0px));
            }

            .marquee-reverse {
                animation-direction: reverse;
            }
        }
    </style>
</BaseLayout>
